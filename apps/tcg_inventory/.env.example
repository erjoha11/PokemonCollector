# Optional: only needed to use "Fra Dropbox" on the Import page instead of
# uploading CSV files by hand. See README.md "Dropbox import setup".
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Default folder shown on the Import page (can also be typed/changed there
# at any time, this just saves retyping it every sync).
DROPBOX_FOLDER=/Dex Exports

# Optional: only needed to deploy to Vercel + Supabase instead of running
# locally with SQLite. See README.md "Deploying to Vercel + Supabase".
# A Supabase Postgres connection string (use the "connection pooling" one,
# port 6543, not the direct one -- see README).
DATABASE_URL=

# Supabase project URL, anon (public) key, and the project's JWT secret --
# all from Supabase dashboard -> Settings -> API. Setting these three
# enables login (Supabase Auth) on every route except /login and /static.
# Leave empty to keep running the app without a login screen.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Optional: protects the Vercel Cron-triggered /cron/dropbox-sync endpoint
# (see README.md "Automatic daily sync"). Any random string -- Vercel sends
# it back automatically as `Authorization: Bearer <CRON_SECRET>` on its own
# cron requests. Leave empty to run that endpoint unauthenticated.
CRON_SECRET=

# The Facebook wins inbox (POST /inbox/fb-wins, see README.md "Facebook wins
# inbox"): fb_auction_watcher sends your won lots here with
# `Authorization: Bearer <INBOX_TOKEN>`. A long random string (e.g.
# `python -c "import secrets; print(secrets.token_urlsafe(32))"`), the same
# value pasted into the extension's Settings. Separate from CRON_SECRET on
# purpose. Fails closed: with login configured (SUPABASE_*) and this empty,
# the endpoint refuses everything; only a local no-login run accepts sends
# without it.
INBOX_TOKEN=
