# Optional: only needed to use "Fra Dropbox" on the Import page instead of
# uploading CSV files by hand. See README.md "Dropbox import setup".
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Default folder shown on the Import page (can also be typed/changed there
# at any time, this just saves retyping it every sync).
DROPBOX_FOLDER=/Dex Exports
