# Optional: only needed to use "Fra Dropbox" on the Import page instead of
# uploading CSV files by hand. See README.md "Dropbox import setup".
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=

# Default folder shown on the Import page (can also be typed/changed there
# at any time, this just saves retyping it every sync).
DROPBOX_FOLDER=/Dex Exports

# Optional: only needed to deploy to Vercel + Supabase instead of running
# locally with SQLite. See README.md "Deploying to Vercel + Supabase".
# A Supabase Postgres connection string (use the "connection pooling" one,
# port 6543, not the direct one -- see README).
DATABASE_URL=

# Supabase project URL, anon (public) key, and the project's JWT secret --
# all from Supabase dashboard -> Settings -> API. Setting these three
# enables login (Supabase Auth) on every route except /login and /static.
# Leave empty to keep running the app without a login screen.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=
