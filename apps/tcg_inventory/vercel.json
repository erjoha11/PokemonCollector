{
  "builds": [
    {
      "src": "api/index.py",
      "use": "@vercel/python",
      "config": { "includeFiles": ["templates/**", "static/**"] }
    }
  ],
  "routes": [
    { "src": "/(.*)", "dest": "api/index.py" }
  ],
  "crons": [
    { "path": "/cron/dropbox-sync", "schedule": "0 5 * * *" },
    { "path": "/cron/price-refresh", "schedule": "0 6 * * *" }
  ]
}
