{
  "manifest_version": 3,
  "name": "FB Auction Watcher",
  "short_name": "FB Auction Watcher",
  "version": "0.1.0",
  "description": "Read-only overview of auctions in a Facebook buy/sell group.",
  "permissions": [
    "alarms",
    "contextMenus",
    "idle",
    "nativeMessaging",
    "notifications",
    "storage"
  ],
  "host_permissions": [
    "https://www.facebook.com/*"
  ],
  "optional_host_permissions": [
    "https://*/*",
    "http://localhost/*",
    "http://127.0.0.1/*"
  ],
  "action": {
    "default_title": "FB Auction Watcher",
    "default_popup": "popup.html"
  },
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.facebook.com/*"
      ],
      "js": [
        "content-post.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
