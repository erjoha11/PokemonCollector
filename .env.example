# All optional -- with none of these set, `python app.py` runs locally on
# SQLite with no login. See apps/tcg_inventory/README.md for details.

# Postgres (e.g. Supabase) instead of local SQLite. Required on Vercel.
DATABASE_URL=

# Supabase Auth login. Skipped entirely unless URL + anon key are both set.
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_JWT_SECRET=

# Dropbox Dex CSV import (run `python dropbox_setup.py` once to get these).
DROPBOX_APP_KEY=
DROPBOX_APP_SECRET=
DROPBOX_REFRESH_TOKEN=
DROPBOX_FOLDER=

# Shared secret for GET /cron/dropbox-sync.
CRON_SECRET=
